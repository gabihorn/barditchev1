# Long random strings. Generate with:  openssl rand -hex 24
ADMIN_TOKEN=change-me-admin-token-xxxxxxxx
AGENT_TOKEN=

# The admin user/password you choose in the AdGuard setup wizard
ADGUARD_USER=admin
ADGUARD_PASSWORD=change-me

# The Windows PC to restrict (give it a DHCP reservation / static IP first)
ADGUARD_CLIENTS=192.168.1.50

ADGUARD_WEB_PORT=8080
CONTROL_PORT=8088
